<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ page_title }}</title>
  <meta name="description" content="{{ page_description | escape }}">
  <!-- Fonts: Lato (body) + Josefin Sans (headings) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,700;0,900;1,400&family=Josefin+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* ===== LayoutKart Cloth Store — Apple-like clean design ===== */
    :root {
      --font-body: 'Lato', -apple-system, sans-serif;
      --font-heading: 'Josefin Sans', -apple-system, sans-serif;
      --color-black: #000000;
      --color-white: #ffffff;
      --color-grey-100: #f5f5f7;
      --color-grey-300: #d2d2d7;
      --color-grey-600: #6e6e73;
      --color-text: #1d1d1f;
      --color-accent: #e63946;
      --radius: 12px;
    }
    * { box-sizing: border-box; }
    body {
      font-family: var(--font-body);
      color: var(--color-text);
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
      line-height: 1.6;
    }
    h1, h2, h3, h4, h5, h6 {
      font-family: var(--font-heading);
      font-weight: 600;
      letter-spacing: -0.01em;
    }
    /* Black buttons — Apple style */
    .btn, button[type="submit"], .button {
      display: inline-block;
      background: var(--color-black);
      color: var(--color-white);
      font-family: var(--font-body);
      font-weight: 700;
      padding: 14px 32px;
      border: none;
      border-radius: 980px;
      cursor: pointer;
      text-decoration: none;
      font-size: 16px;
      transition: opacity 0.2s, transform 0.2s;
    }
    .btn:hover, button[type="submit"]:hover, .button:hover {
      opacity: 0.85;
      transform: scale(1.02);
    }
    .btn-secondary {
      background: var(--color-grey-100);
      color: var(--color-black);
    }
    /* Product cards — clean */
    .product-card {
      background: var(--color-white);
      border-radius: var(--radius);
      overflow: hidden;
      transition: box-shadow 0.3s;
    }
    .product-card:hover {
      box-shadow: 0 8px 30px rgba(0,0,0,0.08);
    }
    /* Badges */
    .badge-sale {
      background: var(--color-accent);
      color: #fff;
      font-size: 12px;
      font-weight: 700;
      padding: 4px 12px;
      border-radius: 980px;
      text-transform: uppercase;
    }
    /* Section spacing — Apple-like whitespace */
    .section { padding: 80px 20px; }
    .container { max-width: 1200px; margin: 0 auto; }
    /* Mobile */
    @media (max-width: 768px) {
      .section { padding: 50px 16px; }
      h1 { font-size: 32px !important; }
      h2 { font-size: 26px !important; }
    }
  </style>
  {{ content_for_header }}
</head>
<body>
  {{ content_for_layout }}
</body>
</html>
