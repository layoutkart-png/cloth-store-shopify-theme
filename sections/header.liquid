<header class="site-header" style="display: flex; justify-content: space-between; align-items: center; padding: 15px 30px; border-bottom: 1px solid #eee;">
  <div class="logo">
    {% if section.settings.logo %}
      <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" style="max-height: 50px;">
    {% else %}
      <h2 style="margin: 0;">{{ shop.name }}</h2>
    {% endif %}
  </div>
  <nav class="main-nav">
    {% for link in linklists[section.settings.menu].links %}
      <a href="{{ link.url }}" style="margin: 0 15px; text-decoration: none; color: #333;">{{ link.title }}</a>
    {% endfor %}
  </nav>
  <div class="header-icons">
    <a href="/search" style="margin-right: 15px;">🔍</a>
    <a href="/account">👤</a>
    <a href="/cart" style="margin-left: 15px;">🛒 ({{ cart.item_count }})</a>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
