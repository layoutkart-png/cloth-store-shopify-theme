<div class="collection-page container section">
  <h1 style="text-align: center; margin-bottom: 10px;">{{ collection.title }}</h1>
  {% if collection.description != blank %}
    <p style="text-align: center; color: #666; max-width: 600px; margin: 0 auto 40px;">{{ collection.description }}</p>
  {% endif %}

  <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;" class="collection-grid">
    {% for product in collection.products %}
      <div class="product-card">
        <a href="{{ product.url }}" style="text-decoration: none; color: inherit;">
          <div style="position: relative;">
            <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title }}" style="width: 100%; aspect-ratio: 3/4; object-fit: cover; border-radius: 12px;">
            {% if product.compare_at_price > product.price %}
              <span class="badge-sale" style="position: absolute; top: 10px; left: 10px;">-{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%</span>
            {% endif %}
          </div>
          <div style="padding: 12px 4px;">
            <h3 style="font-size: 15px; margin: 0 0 6px; font-family: 'Lato', sans-serif;">{{ product.title }}</h3>
            <div style="display: flex; gap: 8px; align-items: center;">
              <span style="font-weight: 900;">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span style="text-decoration: line-through; color: #999; font-size: 13px;">{{ product.compare_at_price | money }}</span>
              {% endif %}
            </div>
          </div>
        </a>
      </div>
    {% else %}
      <p style="grid-column: 1/-1; text-align: center; color: #999;">No products found in this collection.</p>
    {% endfor %}
  </div>
</div>

<style>
  @media (max-width: 768px) {
    .collection-grid { grid-template-columns: repeat(2, 1fr) !important; }
  }
</style>

{% schema %}
{
  "name": "Main Collection",
  "settings": []
}
{% endschema %}
