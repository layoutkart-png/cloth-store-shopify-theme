<div class="product-reviews section" style="background: #f5f5f7;">
  <div class="container">
    <h2 style="text-align: center; margin-bottom: 10px;">{{ section.settings.heading }}</h2>
    <p style="text-align: center; color: #666; margin-bottom: 40px;">
      <span style="color: #ffc107; font-size: 20px;">★★★★★</span>
      {{ section.settings.rating }} out of 5 — based on {{ section.settings.review_count }} reviews
    </p>
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;" class="reviews-grid">
      {% for block in section.blocks %}
        <div style="background: #fff; padding: 25px; border-radius: 12px;">
          <div style="color: #ffc107; margin-bottom: 10px;">★★★★★</div>
          <p style="font-weight: 700; margin: 0 0 5px;">{{ block.settings.title }}</p>
          <p style="color: #555; font-size: 14px; margin: 0 0 15px;">{{ block.settings.body }}</p>
          <div style="display: flex; align-items: center; gap: 10px;">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: #000; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700;">
              {{ block.settings.name | slice: 0 }}
            </div>
            <div>
              <p style="margin: 0; font-weight: 600; font-size: 14px;">{{ block.settings.name }}</p>
              <p style="margin: 0; color: #999; font-size: 12px;">✓ Verified Buyer</p>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  @media (max-width: 768px) {
    .reviews-grid { grid-template-columns: 1fr !important; }
  }
</style>

{% schema %}
{
  "name": "Product Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Reviews"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Average rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Total reviews",
      "default": "2,347"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Review title",
          "default": "Perfect fit!"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review text",
          "default": "The fabric quality is amazing for this price. Delivery was quick too!"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Reviewer name",
          "default": "Priya S."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
