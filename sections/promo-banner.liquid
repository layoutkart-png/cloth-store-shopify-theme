<div class="promo-banner" style="position: relative; text-align: center; padding: 80px 20px; background: {% if section.settings.bg_image %}url('{{ section.settings.bg_image | image_url: width: 1920 }}') center/cover{% else %}linear-gradient(135deg, {{ section.settings.bg_color_1 }}, {{ section.settings.bg_color_2 }}){% endif %};">
  <div style="position: relative; z-index: 2; max-width: 700px; margin: 0 auto;">
    {% if section.settings.badge_text != blank %}
      <span style="display: inline-block; background: rgba(255,255,255,0.2); color: {{ section.settings.text_color }}; padding: 6px 20px; border-radius: 980px; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 15px; border: 1px solid rgba(255,255,255,0.3);">{{ section.settings.badge_text }}</span>
    {% endif %}
    <h2 style="font-size: 42px; color: {{ section.settings.text_color }}; margin: 0 0 15px;">{{ section.settings.heading }}</h2>
    <p style="font-size: 18px; color: {{ section.settings.text_color }}; opacity: 0.9; margin: 0 0 30px;">{{ section.settings.subtext }}</p>
    <a href="{{ section.settings.button_link }}" class="btn" style="background: {{ section.settings.button_color }};">{{ section.settings.button_text }}</a>
  </div>
</div>

{% schema %}
{
  "name": "Promo Banner",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Top badge text",
      "default": "Limited Time"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Diwali Mega Sale — Up to 50% OFF"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "On all ethnic wear. Hurry, offer ends soon!"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image (optional)"
    },
    {
      "type": "color",
      "id": "bg_color_1",
      "label": "Gradient color 1",
      "default": "#1a1a2e"
    },
    {
      "type": "color",
      "id": "bg_color_2",
      "label": "Gradient color 2",
      "default": "#e63946"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop the Sale"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Promo Banner"
    }
  ]
}
{% endschema %}
